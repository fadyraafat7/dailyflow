<article class="task-card" id="task-<%= id %>" data-id="<%= id %>" data-title="<%= title %>" data-project-id="<%= projectDocId %>" data-project-name="<%= projectName %>" data-priority="<%= priority %>" data-state="<%= state %>" data-planned-date="<%= plannedDateRaw %>" data-assigned-to="<%= assignedToId %>">
  <div>
    <h4 class="task-card__title"><%= title %></h4>
    <%- projectLink %>
    <div class="task-card__meta">
      <span class="badge priority--<%= priority %>"><%= priority %></span>
      <span class="badge state--<%= state %>"><%= state %></span>
      <%- date %>
      <%- addedBy %>
      <%- assignedTo %>
    </div>
    <%- timeSummary %>
  </div>
  <div class="task-card__actions">
    <%- timerControls %>
    <button type="button" class="btn-icon btn-pin" title="Pin task"
      onclick="window._pinTask('<%= id %>', this)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg></button>
    <button type="button" class="btn-icon" title="Track time"
      @click="$dispatch('open-time-entry', { id: $el.closest('.task-card').dataset.id, title: $el.closest('.task-card').dataset.title, projectDocId: $el.closest('.task-card').dataset.projectId, projectName: $el.closest('.task-card').dataset.projectName })"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></button>
    <button type="button" class="btn-icon" title="Edit" x-show="can('task.update')"
      @click="$dispatch('open-edit', { id: $el.closest('.task-card').dataset.id, title: $el.closest('.task-card').dataset.title, priority: $el.closest('.task-card').dataset.priority, state: $el.closest('.task-card').dataset.state, assignedTo: $el.closest('.task-card').dataset.assignedTo })"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
    <button type="button" class="btn-icon btn-delete" title="Delete" x-show="can('task.delete')"
      hx-delete="/api/tasks/<%= id %>" hx-target="closest .task-card" hx-swap="outerHTML"
      hx-confirm="Are you sure?"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
  </div>
</article>