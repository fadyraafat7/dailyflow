<article class="time-entry-card" data-id="<%= id %>" data-started-at="<%= startedAt %>" data-stopped-at="<%= stoppedAt %>" data-duration="<%= duration %>">
  <div class="time-entry-card__meta">
    <span class="badge state--<%= status %>"><%= status %></span>
    <time datetime="<%= startedAt %>"><%= startedAt %></time>
    <%- stoppedAtHtml %>
    <%- durationHtml %>
  </div>
  <div class="time-entry-card__actions">
    <button type="button" class="btn-icon" data-action="edit-time-entry" title="Edit" x-show="can('time-entry.update')"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
    <button type="button" class="btn-icon btn-delete" data-action="delete-time-entry" title="Delete" x-show="can('time-entry.delete')"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
  </div>
</article>