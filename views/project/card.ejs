<article class="project-card project-card--clickable" data-id="<%= id %>" data-name="<%= name %>" data-count="<%= count %>" data-state="<%= state %>" data-description="<%= descriptionText %>"
  :class="{ 'is-selected': selected && selected.id === $el.dataset.id }"
  @click="selectProject($el)">
  <header class="project-card__head">
    <h3 class="project-card__name"><%= name %></h3>
    <span class="badge state--<%= state %>"><%= state %></span>
    <span class="badge badge--count"><%= count %> <%= taskLabel %></span>
    <button type="button" class="btn-icon btn-pin" title="Pin project"
        onclick="window._pinProject('<%= id %>', this)" @click.stop><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg></button>
    <button type="button" class="btn-icon" title="Edit project" x-show="can('project.update')"
        hx-get="/api/projects/<%= id %>/edit-form" hx-target="#modal-container" hx-swap="innerHTML"
        @click.stop><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
    <button type="button" class="btn-icon btn-delete" title="Delete project" x-show="can('project.delete')"
        hx-delete="/api/projects/<%= id %>"
        hx-swap="none"
        hx-confirm="Are you sure you want to delete this project?"
        @htmx:after-request="$dispatch('refresh-projects')"
        @click.stop><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
  </header>
  <%- description %>
</article>